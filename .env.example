# Optional. Runtime environment label included in application diagnostics.
APP_ENV=development

# Optional. SQLite is the default. Use an absolute URL only when your environment requires it.
DATABASE_URL=sqlite:///./data/certificates.db

# Optional. Generated PDFs are stored beneath this relative directory.
STORAGE_DIR=./data/certificates

# Optional. Request-level limit for recipients in one bulk job.
MAX_RECIPIENTS=500

# Optional. Standard Python logging level.
LOG_LEVEL=INFO

