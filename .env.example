# Optional. Runtime environment label included in application diagnostics.
APP_ENV=development

# Optional. "inline" uses FastAPI background tasks; "distributed" uses Celery workers.
PROCESSING_MODE=inline

# Optional. SQLite is the default. Use an absolute URL only when your environment requires it.
DATABASE_URL=sqlite:///./data/certificates.db

# Optional alternative to DATABASE_URL for managed PostgreSQL deployments. When DATABASE_HOST
# is set, DATABASE_NAME, DATABASE_USER, and DATABASE_PASSWORD are required and safely URL-encoded.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL_MODE=prefer

# Optional. "local" stores artifacts beneath STORAGE_DIR. Distributed mode requires "s3".
STORAGE_BACKEND=local

# Optional. Generated PDFs are stored beneath this relative directory.
STORAGE_DIR=./data/certificates

# Optional. Request-level limit for the JSON endpoint.
MAX_RECIPIENTS=500

# Optional. Row limit for streaming CSV imports. Zero disables the application-level row cap.
MAX_CSV_RECIPIENTS=0

# Optional. Maximum number of PDFs rendered concurrently inside one job.
RENDER_WORKERS=4

# Optional. Recipient outcomes persisted in each database transaction.
PROCESSING_BATCH_SIZE=100

# Optional. Distributed tasks sent for each job. Database leases prevent duplicate processing.
DISTRIBUTED_JOB_PARALLELISM=4

# Optional. Seconds before interrupted distributed work is eligible for recovery.
CLAIM_TIMEOUT_SECONDS=300

# Required only in distributed mode. Redis is used as the Celery broker.
CELERY_BROKER_URL=redis://localhost:6379/0

# Optional alternative to CELERY_BROKER_URL for secret-injected Redis or Valkey deployments.
# CELERY_BROKER_PASSWORD is required when CELERY_BROKER_HOST is configured.
CELERY_BROKER_HOST=
CELERY_BROKER_PORT=6379
CELERY_BROKER_USERNAME=
CELERY_BROKER_PASSWORD=
CELERY_BROKER_TLS=false

# Required only with STORAGE_BACKEND=s3. Blank credentials use the standard AWS credential chain.
S3_BUCKET=certflow
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_AUTO_CREATE_BUCKET=false

# Optional. Standard Python logging level.
LOG_LEVEL=INFO

# Optional. Use "json" for structured logs or "text" for local readability.
LOG_FORMAT=json
