# Required local infrastructure values. Choose strong values and save this file as .env.distributed.
POSTGRES_DB=certflow
POSTGRES_USER=certflow
POSTGRES_PASSWORD=replace-with-a-local-postgres-password

# These values seed the local S3-compatible object store and are used by boto3.
S3_ACCESS_KEY_ID=replace-with-a-local-object-storage-user
S3_SECRET_ACCESS_KEY=replace-with-a-local-object-storage-password

# Optional scaling controls.
CELERY_WORKER_CONCURRENCY=2
DISTRIBUTED_JOB_PARALLELISM=16
PROCESSING_BATCH_SIZE=100
RENDER_WORKERS=1
CLAIM_TIMEOUT_SECONDS=300
MAX_RECIPIENTS=500
MAX_CSV_RECIPIENTS=0
